{
  "name": "courttide-connectors-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p packages/connectors/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "npm run build --workspace @courttide/connectors",
    "schema:generate": "node scripts/generate-tenant-schema.mjs",
    "docs:platforms": "node scripts/platform-list.mjs",
    "docs:platforms:check": "node scripts/platform-list.mjs --check",
    "check:no-court-data": "node scripts/check-no-court-data.mjs",
    "check": "npm run lint && npm run format:check && npm run docs:platforms:check && npm run typecheck && npm test && npm run build && npm run check:no-court-data"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@types/node": "26.6.5",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
