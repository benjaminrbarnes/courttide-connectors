{
  "name": "@courttide/connectors",
  "version": "0.1.1",
  "description": "Read-only connectors for court availability",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benjaminrbarnes/courttide-connectors.git",
    "directory": "packages/connectors"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "courttide-connectors": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./activenet": {
      "types": "./dist/platforms/activenet/index.d.ts",
      "default": "./dist/platforms/activenet/index.js"
    },
    "./civicrec": {
      "types": "./dist/platforms/civicrec/index.d.ts",
      "default": "./dist/platforms/civicrec/index.js"
    },
    "./schema/tenant.schema.json": "./dist/schema/tenant.schema.json"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-package-schema.mjs"
  }
}
